{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.11.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"none","dataSources":[{"sourceType":"datasetVersion","sourceId":13832125},{"sourceType":"datasetVersion","sourceId":13827880}],"dockerImageVersionId":31192,"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"!pip install transformers scikit-image einops -q\n\nimport os, json, random\nfrom pathlib import Path\nimport numpy as np\nimport cv2\nfrom tqdm import tqdm\n\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom torch.utils.data import Dataset, DataLoader\n\nfrom transformers import ViTMAEForPreTraining, ViTMAEConfig\nfrom einops import rearrange\nfrom scipy.ndimage import distance_transform_edt\n\ndevice = \"cuda\" if torch.cuda.is_available() else \"cpu\"\nprint(\"Device:\", device)","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true,"execution":{"iopub.status.busy":"2025-11-28T22:47:47.810665Z","iopub.execute_input":"2025-11-28T22:47:47.810981Z","iopub.status.idle":"2025-11-28T22:48:31.47839Z","shell.execute_reply.started":"2025-11-28T22:47:47.810952Z","shell.execute_reply":"2025-11-28T22:48:31.477561Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"class FAZDataset(Dataset):\n    def __init__(self, img_dir, faz_dir, split=\"train\",\n                 fraction=1.0, size=224):\n        self.size = size\n        img_dir  = Path(img_dir)\n        faz_dir  = Path(faz_dir)\n\n        # All images and masks indexed by stem\n        img_files = {f.stem: f for f in img_dir.glob(\"*.bmp\")}\n        faz_files = {f.stem: f for f in faz_dir.glob(\"*.bmp\")}\n\n        # Only keep IDs that exist in BOTH\n        common_ids = sorted(set(img_files.keys()) & set(faz_files.keys()))\n        if not common_ids:\n            raise ValueError(\"No overlapping IDs between image dir and GT_FAZ!\")\n\n        # Train/val split\n        split_idx = int(0.8 * len(common_ids))\n        if split == \"train\":\n            ids = common_ids[:split_idx]\n            ids = ids[: int(len(ids) * fraction)]\n        else:\n            ids = common_ids[split_idx:]\n\n        self.samples = [(img_files[i], faz_files[i]) for i in ids]\n        print(f\"{split.upper()} – {len(self.samples)} samples \"\n              f\"(from {len(common_ids)} common IDs)\")\n\n    def __len__(self):\n        return len(self.samples)\n\n    def __getitem__(self, idx):\n        img_path, mask_path = self.samples[idx]\n\n        img  = cv2.imread(str(img_path), cv2.IMREAD_GRAYSCALE)\n        mask = cv2.imread(str(mask_path), cv2.IMREAD_GRAYSCALE)\n\n        img  = cv2.resize(img,  (self.size, self.size), interpolation=cv2.INTER_LINEAR)\n        mask = cv2.resize(mask, (self.size, self.size), interpolation=cv2.INTER_NEAREST)\n\n        img  = torch.from_numpy(img).float().unsqueeze(0) / 255.0\n        mask = (torch.from_numpy(mask).float().unsqueeze(0) > 0).float()\n\n        return img, mask","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-28T22:48:31.479801Z","iopub.execute_input":"2025-11-28T22:48:31.480939Z","iopub.status.idle":"2025-11-28T22:48:31.489976Z","shell.execute_reply.started":"2025-11-28T22:48:31.480899Z","shell.execute_reply":"2025-11-28T22:48:31.489129Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"class SegHead(nn.Module):\n    def __init__(self, hidden=768, size=224, patch=16):\n        super().__init__()\n        gs = size // patch   # grid size (14x14)\n        self.gs = gs\n\n        self.up1 = nn.ConvTranspose2d(hidden, 256, 2, 2)\n        self.up2 = nn.ConvTranspose2d(256, 128, 2, 2)\n        self.up3 = nn.ConvTranspose2d(128, 64,  2, 2)\n        self.up4 = nn.ConvTranspose2d(64,  32,  2, 2)\n        self.out = nn.Conv2d(32, 1, 1)\n\n    def forward(self, x):\n        B, N, C = x.shape\n        x = x.reshape(B, self.gs, self.gs, C).permute(0,3,1,2)\n        x = F.relu(self.up1(x))\n        x = F.relu(self.up2(x))\n        x = F.relu(self.up3(x))\n        x = F.relu(self.up4(x))\n        return self.out(x)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-28T22:48:31.490787Z","iopub.execute_input":"2025-11-28T22:48:31.491068Z","iopub.status.idle":"2025-11-28T22:48:31.53368Z","shell.execute_reply.started":"2025-11-28T22:48:31.49104Z","shell.execute_reply":"2025-11-28T22:48:31.532807Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"class VAMAE(nn.Module):\n    def __init__(self):\n        super().__init__()\n        cfg = ViTMAEConfig(\n            image_size=224,\n            patch_size=16,\n            num_channels=1,\n            hidden_size=768,\n            num_hidden_layers=12,\n            num_attention_heads=12,\n            intermediate_size=3072,\n        )\n        self.encoder = ViTMAEForPreTraining(cfg).vit\n\n    def forward(self, x):\n        B = x.shape[0]\n        emb = self.encoder.embeddings.patch_embeddings(x)\n        emb = emb + self.encoder.embeddings.position_embeddings[:,1:,:]\n        cls = self.encoder.embeddings.cls_token.expand(B,-1,-1)\n        out = torch.cat([cls, emb],1)\n        out = self.encoder.encoder(out).last_hidden_state[:,1:,:]\n        return out\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-28T22:48:31.535925Z","iopub.execute_input":"2025-11-28T22:48:31.536454Z","iopub.status.idle":"2025-11-28T22:48:31.55235Z","shell.execute_reply.started":"2025-11-28T22:48:31.536425Z","shell.execute_reply":"2025-11-28T22:48:31.551426Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"class FAZSegModel(nn.Module):\n    def __init__(self, encoder):\n        super().__init__()\n        self.encoder = encoder\n        self.head = SegHead()\n\n    def forward(self, x):\n        tokens = self.encoder(x)\n        return self.head(tokens)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-28T22:48:31.553275Z","iopub.execute_input":"2025-11-28T22:48:31.55357Z","iopub.status.idle":"2025-11-28T22:48:31.566438Z","shell.execute_reply.started":"2025-11-28T22:48:31.553541Z","shell.execute_reply":"2025-11-28T22:48:31.565747Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def dice(pred, mask):\n    pred = (torch.sigmoid(pred) > 0.5).float()\n    inter = (pred*mask).sum()\n    union = pred.sum() + mask.sum()\n    return (2*inter + 1e-8)/(union + 1e-8)\n\ndef iou(pred, mask):\n    pred = (torch.sigmoid(pred) > 0.5).float()\n    inter = (pred*mask).sum()\n    union = pred.sum() + mask.sum() - inter\n    return (inter + 1e-8)/(union + 1e-8)\n\ndef hd95(pred, mask):\n    pred = (torch.sigmoid(pred)>0.5).cpu().numpy()[0,0].astype(np.uint8)\n    mask = mask.cpu().numpy()[0,0].astype(np.uint8)\n\n    if pred.max()==0 or mask.max()==0:\n        return 999\n\n    pb = pred - cv2.erode(pred, np.ones((3,3)), borderType=cv2.BORDER_CONSTANT)\n    mb = mask - cv2.erode(mask, np.ones((3,3)), borderType=cv2.BORDER_CONSTANT)\n\n    dt_p = distance_transform_edt(1-pred)\n    dt_m = distance_transform_edt(1-mask)\n\n    d1 = dt_p[mb.astype(bool)]\n    d2 = dt_m[pb.astype(bool)]\n\n    d = np.concatenate([d1,d2])\n    return np.percentile(d,95)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-28T22:48:31.567465Z","iopub.execute_input":"2025-11-28T22:48:31.567786Z","iopub.status.idle":"2025-11-28T22:48:31.582153Z","shell.execute_reply.started":"2025-11-28T22:48:31.567758Z","shell.execute_reply":"2025-11-28T22:48:31.581133Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def train_seg(model, train_loader, val_loader, epochs=20, lr=1e-4):\n    opt = torch.optim.Adam(model.parameters(), lr=lr)\n    model.to(device)\n\n    def dice_loss(pred, target, smooth=1.0):\n        prob   = torch.sigmoid(pred)\n        prob   = prob.view(prob.size(0), -1)\n        target = target.view(target.size(0), -1)\n        inter  = (prob * target).sum(dim=1)\n        union  = prob.sum(dim=1) + target.sum(dim=1)\n        dice   = (2*inter + smooth) / (union + smooth)\n        return 1.0 - dice.mean()\n\n    for ep in range(epochs):\n        model.train()\n        losses = []\n\n        for img, m in train_loader:\n            img, m = img.to(device), m.to(device)\n            pred = model(img)\n\n            bce   = F.binary_cross_entropy_with_logits(pred, m)\n            dloss = dice_loss(pred, m)\n            loss  = bce + dloss         # <--- this line is important\n\n            opt.zero_grad()\n            loss.backward()\n            opt.step()\n            losses.append(loss.item())\n\n        # validation\n        model.eval()\n        dices, ious, hds = [], [], []\n        with torch.no_grad():\n            for img, m in val_loader:\n                img, m = img.to(device), m.to(device)\n                pred = model(img)\n                dices.append(dice(pred, m).item())\n                ious.append(iou(pred, m).item())\n                hds.append(hd95(pred, m))\n\n        print(\n            f\"Epoch {ep+1}/{epochs}  \"\n            f\"Loss={np.mean(losses):.4f}  \"\n            f\"Dice={np.mean(dices):.4f}  \"\n            f\"IoU={np.mean(ious):.4f}  \"\n            f\"HD95={np.mean(hds):.2f}\"\n        )\n\n    return model","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-28T22:48:31.583049Z","iopub.execute_input":"2025-11-28T22:48:31.583376Z","iopub.status.idle":"2025-11-28T22:48:31.600154Z","shell.execute_reply.started":"2025-11-28T22:48:31.583351Z","shell.execute_reply":"2025-11-28T22:48:31.599281Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def run_faz_for_encoder(\n    encoder,\n    img_dir,\n    faz_dir,\n    label_fraction,  \n    tag,            \n    epochs=20,\n    batch_size=8,\n):\n    \"\"\"\n    Runs FAZ segmentation (one experiment) for a given encoder and label fraction.\n    Returns (trained_model, final_dice, final_iou, final_hd95).\n    \"\"\"\n\n    print(f\"\\n==============================\")\n    print(f\"Running FAZ {tag} with {label_fraction*100:.1f}% labels\")\n    print(f\"==============================\")\n\n    # Dataset + loaders\n    train_ds = FAZDataset(img_dir, faz_dir, split=\"train\", fraction=label_fraction)\n    val_ds   = FAZDataset(img_dir, faz_dir, split=\"val\",   fraction=1.0)\n\n    train_loader = DataLoader(train_ds, batch_size=batch_size, shuffle=True)\n    val_loader   = DataLoader(val_ds, batch_size=batch_size)\n\n    # Build segmentation model with this encoder\n    model = FAZSegModel(encoder)\n    model = train_seg(model, train_loader, val_loader, epochs=epochs)\n\n    # After training, do one quick pass on val set to get final metrics\n    model.eval()\n    dices, ious, hds = [], [], []\n    with torch.no_grad():\n        for img, m in val_loader:\n            img, m = img.to(device), m.to(device)\n            pred = model(img)\n            dices.append(dice(pred, m).item())\n            ious.append(iou(pred, m).item())\n            hds.append(hd95(pred, m))\n\n    final_dice = float(np.mean(dices))\n    final_iou  = float(np.mean(ious))\n    final_hd   = float(np.mean(hds))\n\n    print(f\"\\n{tag} FINAL METRICS:\")\n    print(f\"Dice = {final_dice:.4f}\")\n    print(f\"IoU  = {final_iou:.4f}\")\n    print(f\"HD95 = {final_hd:.2f}\")\n\n    # Save model weights\n    torch.save(model.state_dict(), f\"FAZ_{tag}.pth\")\n    print(f\"Saved weights to FAZ_{tag}.pth\")\n\n    return model, final_dice, final_iou, final_hd\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-28T22:48:31.600984Z","iopub.execute_input":"2025-11-28T22:48:31.60129Z","iopub.status.idle":"2025-11-28T22:48:31.618944Z","shell.execute_reply.started":"2025-11-28T22:48:31.601262Z","shell.execute_reply":"2025-11-28T22:48:31.618003Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"base = Path(\"/kaggle/input/octa-500-v2\")\nimg3 = base/\"OCTA_3mm/Projection Maps/OCTA(FULL)\"\nimg6 = base/\"OCTA_6mm/Projection Maps/OCTA(FULL)\"\nfaz  = base/\"GT_FAZ\"\n\nckpt = \"/kaggle/input/vamae-checkpoints/vamae_model.pth\"\n\nvamae = VAMAE()\nstate = torch.load(ckpt, map_location=device)\n\nmissing, unexpected = vamae.load_state_dict(state, strict=False)\n\nprint(\"Missing keys:\", missing)\nprint(\"Unexpected keys:\", unexpected)\n\nvamae.to(device)\nvamae.eval()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-28T22:48:31.619809Z","iopub.execute_input":"2025-11-28T22:48:31.620064Z","iopub.status.idle":"2025-11-28T22:48:37.28697Z","shell.execute_reply.started":"2025-11-28T22:48:31.620038Z","shell.execute_reply":"2025-11-28T22:48:37.285884Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import matplotlib.pyplot as plt\n\ntest_ds = FAZDataset(img3, faz, split=\"train\", fraction=1.0)\n\nimg, mask = test_ds[0]\nprint(\"IMG SHAPE:\", img.shape, \"IMG MIN/MAX:\", img.min().item(), img.max().item())\nprint(\"MASK SHAPE:\", mask.shape, \"MASK MIN/MAX:\", mask.min().item(), mask.max().item())\n\nplt.figure(figsize=(12,5))\nplt.subplot(1,2,1); plt.imshow(img.squeeze(), cmap=\"gray\"); plt.title(\"FAZ Input Image\"); plt.axis(\"off\")\nplt.subplot(1,2,2); plt.imshow(mask.squeeze(), cmap=\"gray\"); plt.title(\"FAZ Ground Truth Mask\"); plt.axis(\"off\")\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-28T22:48:37.289303Z","iopub.execute_input":"2025-11-28T22:48:37.289529Z","iopub.status.idle":"2025-11-28T22:48:37.728035Z","shell.execute_reply.started":"2025-11-28T22:48:37.289513Z","shell.execute_reply":"2025-11-28T22:48:37.727186Z"}},"outputs":[],"execution_co