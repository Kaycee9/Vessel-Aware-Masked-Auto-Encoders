subdir).glob('*.png')))\n            print(f\"  {output_folder}/{subdir}: {n} files\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-22T03:43:56.520214Z","iopub.execute_input":"2025-11-22T03:43:56.520617Z","iopub.status.idle":"2025-11-22T03:43:56.527435Z","shell.execute_reply.started":"2025-11-22T03:43:56.520597Z","shell.execute_reply":"2025-11-22T03:43:56.526389Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"class MultiTargetDataset(Dataset):\n    def __init__(self, data_dirs: List[str], image_size: int = 224):\n        self.data_dirs = [Path(d) for d in data_dirs]\n        self.image_size = image_size\n        self.sample_ids = []\n        for data_dir in self.data_dirs:\n            intensity_dir = data_dir / 'intensity'\n            if intensity_dir.exists():\n                for f in sorted(intensity_dir.glob('*.png')):\n                    self.sample_ids.append((data_dir, f.stem))\n        print(f\"Loaded {len(self.sample_ids)} samples\")\n    \n    def __len__(self):\n        return len(self.sample_ids)\n    \n    def load_image(self, path: Path) -> torch.Tensor:\n        img = cv2.imread(str(path), cv2.IMREAD_GRAYSCALE)\n        if img is None:\n            return torch.zeros(1, self.image_size, self.image_size)\n        if img.shape[0] != self.image_size:\n            img = cv2.resize(img, (self.image_size, self.image_size))\n        return torch.from_numpy(img).float().unsqueeze(0) / 255.0\n    \n    def __getitem__(self, idx: int):\n        data_dir, sample_id = self.sample_ids[idx]\n        return {\n            'intensity': self.load_image(data_dir / 'intensity' / f\"{sample_id}.png\"),\n            'vesselness': self.load_image(data_dir / 'vesselness' / f\"{sample_id}.png\"),\n            'skeleton': self.load_image(data_dir / 'skeleton' / f\"{sample_id}.png\")\n        }\n\nclass SegmentationDataset(Dataset):\n    def __init__(self, data_dirs: List[str], image_size: int = 224, \n                 train_fraction: float = 1.0, split: str = 'train'):\n        self.image_size = image_size\n        all_samples = []\n        for data_dir in [Path(d) for d in data_dirs]:\n            intensity_dir = data_dir / 'intensity'\n            if intensity_dir.exists():\n                for f in sorted(intensity_dir.glob('*.png')):\n                    all_samples.append((data_dir, f.stem))\n        split_idx = int(len(all_samples) * 0.8)\n        if split == 'train':\n            self.samples = all_samples[:split_idx]\n            if train_fraction < 1.0:\n                self.samples = self.samples[:int(len(self.samples) * train_fraction)]\n        else:\n            self.samples = all_samples[split_idx:]\n        print(f\"Seg ({split}, {train_fraction*100}%): {len(self.samples)} samples\")\n    \n    def __len__(self):\n        return len(self.samples)\n    \n    def __getitem__(self, idx: int):\n        data_dir, sample_id = self.samples[idx]\n        img = cv2.imread(str(data_dir / 'intensity' / f\"{sample_id}.png\"), cv2.IMREAD_GRAYSCALE)\n        mask = cv2.imread(str(data_dir / 'vesselness' / f\"{sample_id}.png\"), cv2.IMREAD_GRAYSCALE)\n        if img.shape[0] != self.image_size:\n            img = cv2.resize(img, (self.image_size, self.image_size))\n            mask = cv2.resize(mask, (self.image_size, self.image_size))\n        return {\n            'image': torch.from_numpy(img).float().unsqueeze(0) / 255.0,\n            'mask': torch.from_numpy(mask).float().unsqueeze(0) / 255.0\n        }","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-22T03:44:50.206734Z","iopub.execute_input":"2025-11-22T03:44:50.206983Z","iopub.status.idle":"2025-11-22T03:44:50.219199Z","shell.execute_reply.started":"2025-11-22T03:44:50.206966Z","shell.execute_reply":"2025-11-22T03:44:50.218264Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## Task 3: BYOL AUGUMENTATION","metadata":{}},{"cell_type":"code","source":"class VesselAwareAugmentation:\n    \"\"\"\n    BYOL uses augmentations instead of masking.\n    Creates two different views of the same image.\n    \"\"\"\n    def __init__(self, image_size=224, vessel_guided=True, vessel_weight=0.3):\n        self.image_size = image_size\n        self.vessel_guided = vessel_guided\n        self.vessel_weight = vessel_weight\n    \n    def augment_view(self, intensity: torch.Tensor, \n                     vesselness: Optional[torch.Tensor] = None,\n                     skeleton: Optional[torch.Tensor] = None,\n                     strong: bool = False) -> torch.Tensor:\n        \"\"\"Create augmented view\"\"\"\n        aug = intensity.clone()\n        \n        # Geometric augmentations\n        if torch.rand(1) > 0.5:\n            aug = torch.flip(aug, dims=[-1])\n        if torch.rand(1) > 0.5:\n            aug = torch.flip(aug, dims=[-2])\n        \n        k = torch.randint(0, 4, (1,)).item()\n        if k > 0:\n            aug = torch.rot90(aug, k=k, dims=[-2, -1])\n        \n        # Color jittering\n        if strong or torch.rand(1) > 0.3:\n            brightness_factor = 0.4 if strong else 0.2\n            brightness = 1.0 + (torch.rand(1).item() - 0.5) * brightness_factor\n            aug = aug * brightness\n            \n            contrast_factor = 0.4 if strong else 0.2\n            contrast = 1.0 + (torch.rand(1).item() - 0.5) * contrast_factor\n            mean = aug.mean(dim=[-2, -1], keepdim=True)\n            aug = (aug - mean) * contrast + mean\n        \n        # Gaussian blur\n        if strong and torch.rand(1) > 0.5:\n            kernel_size = 3\n            aug = F.avg_pool2d(aug, kernel_size, stride=1, padding=kernel_size//2)\n        \n        # Gaussian noise\n        if torch.rand(1) > 0.5:\n            noise_std = 0.1 if strong else 0.05\n            noise = torch.randn_like(aug) * noise_std\n            aug = aug + noise\n        \n        aug = torch.clamp(aug, 0, 1)\n        return aug\n    \n    def generate_views(self, intensity: torch.Tensor,\n                       vesselness: Optional[torch.Tensor] = None,\n                       skeleton: Optional[torch.Tensor] = None) -> Tuple[torch.Tensor, torch.Tensor]:\n        \"\"\"Generate two augmented views\"\"\"\n        view1 = self.augment_view(intensity, vesselness, skeleton, strong=False)\n        view2 = self.augment_view(intensity, vesselness, skeleton, strong=True)\n        return view1, view2\n\nprint(\"✓ VesselAwareAugmentation loaded (replaces VesselAwareMasking)\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-22T03:44:56.897885Z","iopub.execute_input":"2025-11-22T03:44:56.898162Z","iopub.status.idle":"2025-11-22T03:44:56.908993Z","shell.execute_reply.started":"2025-11-22T03:44:56.898144Z","shell.execute_reply":"2025-11-22T03:44:56.908014Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"class BYOLProjector(nn.Module):\n    \"\"\"MLP projector for BYOL\"\"\"\n    def __init__(self, input_dim=768, hidden_dim=4096, output_dim=256):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Linear(input_dim, hidden_dim),\n            nn.BatchNorm1d(hidden_dim),\n            nn.ReLU(inplace=True),\n            nn.Linear(hidden_dim, output_dim)\n        )\n    \n    def forward(self, x):\n        if x.dim() == 3:\n            x = x.mean(dim=1)  # Average pool patches\n        return self.net(x)\n\n\nclass BYOLPredictor(nn.Module):\n    \"\"\"MLP predictor for online network\"\"\"\n    def __init__(self, input_dim=256, hidden_dim=4096, output_dim=256):\n        super().__init__()\n        self.net = nn.Sequential(\n            nn.Linear(input_dim, hidden_dim),\n            nn.BatchNorm1d(hidden_dim),\n            nn.ReLU(inplace=True),\n            nn.Linear(hidden_dim, output_dim)\n        )\n    \n    def forward(self, x):\n        return self.net(x)\n\nprint(\"✓ BYOLProjector and BYOLPredictor loaded (replaces MultiTargetDecoder)\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-22T03:45:53.750235Z","iopub.execute_input":"2025-11-22T03:45:53.750522Z","iopub.status.idle":"2025-11-22T03:45:53.756766Z","shell.execute_reply.started":"2025-11-22T03:45:53.750503Z","shell.execute_reply":"2025-11-22T03:45:53.755897Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"class BYOL(nn.Module):\n    \"\"\"\n    Main BYOL model - replaces VAMAE\n    Key difference: No decoder, uses EMA target network\n    \"\"\"\n    def __init__(self, image_size=224, patch_size=16, projector_dim=256, \n                 hidden_dim=4096, tau=0.996, augmentation_strategy='hybrid'):\n        super().__init__()\n        self.image_size = image_size\n        self.patch_size = patch_size\n        self.tau = tau\n        \n        # Same encoder as VaMAE\n        config = ViTMAEConfig(\n            image_size=image_size, \n            patch_size=patch_size, \n            num_channels=1,\n            hidden_size=768, \n            num_hidden_layers=12, \n            num_attention_heads=12,\n            intermediate_size=3072\n        )\n        self.encoder = ViTMAEForPreTraining(config).vit\n        \n        # Augmentation instead of masking\n        self.augmentation = VesselAwareAugmentation(\n            image_size, \n            vessel_guided=True if augmentation_strategy == 'hybrid' else False\n        )\n        \n        # BYOL components\n        self.online_projector = BYOLProjector(768, hidden_dim, projector_dim)\n        self.predictor = BYOLPredictor(projector_dim, hidden_dim, projector_dim)\n        \n        # Target network (EMA)\n        self.target_encoder = copy.deepcopy(self.encoder)\n        self.target_projector = copy.deepcopy(self.online_projector)\n        \n        # Freeze target\n        for param in self.target_encoder.parameters():\n            param.requires_grad = False\n        for param in self.target_projector.parameters():\n            param.requires_grad = False\n    \n    @torch.no_grad()\n    def update_target_network(self):\n        \"\"\"EMA update - CRITICAL for BYOL!\"\"\"\n        for online_params, target_params in zip(\n            self.encoder.parameters(), self.target_encoder.parameters()\n        ):\n            target_params.data = self.tau * target_params.data + (1 - self.tau) * online_params.data\n        \n        for online_params, target_params in zip(\n            self.online_projector.parameters(), self.target_projector.parameters()\n        ):\n            target_params.data = self.tau * target_params.data + (1 - self.tau) * online_params.data\n    \n    def encode(self, x, encoder_type='online'):\n        \"\"\"Encode images\"\"\"\n        B = x.shape[0]\n        encoder = self.encoder if encoder_type == 'online' else self.target_encoder\n        \n        embeddings = encoder.embeddings.patch_embeddings(x)\n        embeddings = embeddings + encoder.embeddings.position_embeddings[:, 1:, :]\n        \n        cls_token = encoder.embeddings.cls_token.expand(B, -1, -1)\n        embeddings_with_cls = torch.cat([cls_token, embeddings], dim=1)\n        \n        encoded = encoder.encoder(embeddings_with_cls).last_hidden_state\n        return encoded[:, 1:, :]\n    \n    def forward(self, intensity, vesselness, skeleton):\n        \"\"\"\n        Forward pass - replaces VaMAE's masked reconstruction\n        \"\"\"\n        # Generate two views\n        view1, view2 = self.augmentation.generate_views(intensity, vesselness, skeleton)\n        \n        # Online network\n        online_feat1 = self.encode(view1, 'online')\n        online_proj1 = self.online_projector(online_feat1)\n        online_pred1 = self.predictor(online_proj1)\n        \n        online_feat2 = self.encode(view2, 'online')\n        online_proj2 = self.online_projector(online_feat2)\n        online_pred2 = self.predictor(online_proj2)\n        \n        # Target network\n        with torch.no_grad():\n            target_feat1 = self.encode(view1, 'target')\n            target_proj1 = self.target_projector(target_feat1)\n            \n            target_feat2 = self.encode(view2, 'target')\n            target_proj2 = self.target_projector(target_feat2)\n        \n        # Compute loss\n        loss1 = self.byol_loss(online_pred1, target_proj2.detach())\n        loss2 = self.byol_loss(online_pred2, target_proj1.detach())\n        total_loss = (loss1 + loss2) / 2\n        \n        return {\n            'loss': total_loss,\n            'loss_view1': loss1,\n            'loss_view2': loss2\n        }\n    \n    @staticmethod\n    def byol_loss(pred, target):\n        \"\"\"BYOL loss: normalized MSE\"\"\"\n        pred = F.normalize(pred, dim=-1, p=2)\n        target = F.normalize(target, dim=-1, p=2)\n        return 2 - 2 * (pred * target).sum(dim=-1).mean()\n\nprint(\"✓ BYOL model loaded (replaces VAMAE)\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-22T03:45:59.170928Z","iopub.execute_input":"2025-11-22T03:45:59.171194Z","iopub.status.idle":"2025-11-22T03:45:59.183612Z","shell.execute_reply.started":"2025-11-22T03:45:59.171177Z","shell.execute_reply":"2025-11-22T03:45:59.182723Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"class BYOL(nn.Module):\n    \"\"\"\n    Main BYOL model - replaces VAMAE\n    Key difference: No decoder, uses EMA target network\n    \"\"\"\n    def __init__(self, image_size=224, patch_size=16, projector_dim=256, \n                 hidden_dim=4096, tau=0.996, augmentation_strategy='hybrid'):\n        super().__init__()\n        self.image_size = image_size\n        self.patch_size = patch_size\n        self.tau = tau\n        \n        # Same encoder as VaMAE\n        config = ViTMAEConfig(\n            image_size=image_size, \n            patch_size=patch_size, \n            num_channels=1,\n            hidden_size=768, \n            num_hidden_layers=12, \n            num_attention_heads=12,\n            intermediate_size=3072\n        )\n        self.enco