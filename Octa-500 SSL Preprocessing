{"metadata":{"kernelspec":{"name":"python3","display_name":"Python 3","language":"python"},"language_info":{"name":"python","version":"3.11.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"colab":{"provenance":[]},"kaggle":{"accelerator":"none","dataSources":[{"sourceType":"datasetVersion","sourceId":13041792}],"dockerImageVersionId":31089,"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"markdown","source":"## Preprocessing Steps for OCTA-500\n1. Reads OCTA Projection Maps\n2. Normalizes the pixel values between 0 and 1.\n3. Resizes each image to a standard size (e.g. 256x256).\n4. Generates two additional useful maps:\n  - Vesselness map; highlights vessels using Frangi filter.\n  - Skeleton map; thins vessels to 1-pixel lines (topology).\n5. Saves all outputs into separate folders for training.","metadata":{"id":"ZFvQzLEKkfAr"}},{"cell_type":"code","source":"import os\nimport cv2\nimport numpy as np\nfrom skimage.filters import frangi\nfrom skimage.morphology import skeletonize\nfrom skimage import img_as_ubyte\nfrom tqdm import tqdm   # progress bar for loops\nimport shutil","metadata":{"id":"PbF6R3I6jedn","trusted":true,"execution":{"iopub.status.busy":"2025-09-13T23:04:24.444899Z","iopub.execute_input":"2025-09-13T23:04:24.445203Z","iopub.status.idle":"2025-09-13T23:04:25.234787Z","shell.execute_reply.started":"2025-09-13T23:04:24.445175Z","shell.execute_reply":"2025-09-13T23:04:25.233788Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def normalize_image(img):\n    \"\"\"\n    Normalize image intensity values to [0,1].\n    This will ensure brightness ranges are consistent for the model's input.\n    \"\"\"\n    img = img.astype(np.float32)\n    return (img - img.min()) / (img.max() - img.min() + 1e-8)\n\n\ndef resize_image(img, size=256):\n    \"\"\"\n    Resize the image to a fixed size (default = 256x256).\n    \"\"\"\n    return cv2.resize(img, (size, size), interpolation=cv2.INTER_AREA)\n\n\ndef compute_vesselness(img):\n    \"\"\"\n    Apply Frangi filter to highlight vessel-like structures.\n    OCTA is sparse, and Frangi makes vessels stand out.\n    \"\"\"\n    vesselness = frangi(img, scale_range=(1, 3), scale_step=1)\n    return normalize_image(vesselness)\n\n\ndef compute_skeleton(vesselness, thresh=0.1):\n    \"\"\"\n    Convert the vesselness map into a skeleton (1-pixel thin vessels).\n    \"\"\"\n    binary = (vesselness > thresh).astype(np.uint8)\n    return skeletonize(binary).astype(np.uint8)\n\n\ndef save_image(path, img):\n    \"\"\"\n    Save an image as PNG in grayscale (uint8 format).\n    \"\"\"\n    cv2.imwrite(path, img_as_ubyte(img))","metadata":{"id":"_Y3lgum0mQI3","trusted":true,"execution":{"iopub.status.busy":"2025-09-13T23:04:26.879873Z","iopub.execute_input":"2025-09-13T23:04:26.880286Z","iopub.status.idle":"2025-09-13T23:04:26.88837Z","shell.execute_reply.started":"2025-09-13T23:04:26.880248Z","shell.execute_reply":"2025-09-13T23:04:26.887246Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def preprocess_projectionmaps(\n    root_dir=\"//kaggle/input/octa-500-v1/OCTA_3mm/Projection Maps\",  # input folder\n    out_dir=\"/kaggle/output/processed_3mm\",                      # output folder\n    size=256                                               # resize size\n):\n    \"\"\"\n    Preprocess OCTA Projection Maps:\n      - Reads only OCTA(FULL), OCTA(ILM_OPL), OCTA(OPL_BM).\n      - Saves processed images into intensity, vesselness, skeleton folders.\n    \"\"\"\n\n    # Create output folders if they don't exist\n    os.makedirs(out_dir, exist_ok=True)\n    for sub in [\"intensity\", \"vesselness\", \"skeleton\"]:\n        os.makedirs(os.path.join(out_dir, sub), exist_ok=True)\n\n    # Walk through all subfolders and files\n    for root, _, files in os.walk(root_dir):\n        # Only process OCTA projection maps, not OCT\n        if not any(key in root for key in [\"OCTA(FULL)\", \"OCTA(ILM_OPL)\", \"OCTA(OPL_BM)\"]):\n            continue\n\n        # Process each image file\n        for fname in tqdm(files, desc=f\"Processing {root}\"):\n            if not fname.lower().endswith((\".png\", \".bmp\", \".tif\", \".tiff\")):\n                continue  # skip non-image files\n\n            fpath = os.path.join(root, fname)\n            img = cv2.imread(fpath, cv2.IMREAD_GRAYSCALE)  # read as grayscale\n\n            # Step 1: Normalize\n            norm = normalize_image(img)\n\n            # Step 2: Resize\n            norm_resized = resize_image(norm, size=size)\n\n            # Step 3: Compute vesselness\n            vesselness = compute_vesselness(norm_resized)\n\n            # Step 4: Compute skeleton\n            skeleton = compute_skeleton(vesselness)\n\n            # Step 5: Save results\n            # Example name: OCTA_ILM_OPL_10301_1.png\n            subfolder_type = root.split(os.sep)[-1].replace(\"(\", \"\").replace(\")\", \"\")\n            base = f\"{subfolder_type}_{os.path.splitext(fname)[0]}\"\n\n            save_image(os.path.join(out_dir, \"intensity\", base + \".png\"), norm_resized)\n            save_image(os.path.join(out_dir, \"vesselness\", base + \".png\"), vesselness)\n            save_image(os.path.join(out_dir, \"skeleton\", base + \".png\"), skeleton)\n\n    print(f\"Done! Processed images saved under {out_dir}\")","metadata":{"id":"9IFhpdVHmX57","trusted":true,"execution":{"iopub.status.busy":"2025-09-13T23:04:27.760201Z","iopub.execute_input":"2025-09-13T23:04:27.76058Z","iopub.status.idle":"2025-09-13T23:04:27.770039Z","shell.execute_reply.started":"2025-09-13T23:04:27.760548Z","shell.execute_reply":"2025-09-13T23:04:27.769128Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# For the 3mm data\npreprocess_projectionmaps(\n    root_dir=\"/kaggl